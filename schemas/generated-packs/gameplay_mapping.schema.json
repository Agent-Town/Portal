{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-town-gameplay-mapping-v1",
  "title": "Agent Town Gameplay Mapping",
  "type": "object",
  "required": ["canonicalVersion", "canonicalEntities"],
  "additionalProperties": false,
  "properties": {
    "canonicalVersion": { "type": "string", "minLength": 3 },
    "serverRuleOverrides": { "const": 0 },
    "canonicalEntities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["canonicalId", "mechanicalKey", "generatedName"],
        "additionalProperties": true,
        "properties": {
          "canonicalId": { "type": "string", "minLength": 3 },
          "mechanicalKey": { "type": "string", "minLength": 1 },
          "generatedName": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-town-generation-brief-v1",
  "title": "Agent Town Generation Brief",
  "type": "object",
  "required": [
    "schemaVersion",
    "promptHash",
    "theme",
    "tone",
    "visualStyle",
    "species",
    "factions",
    "cultures",
    "techFlavor",
    "humorLevel",
    "safetyStatus",
    "keywordHints",
    "metrics"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "agent-town-generation-brief-v1" },
    "promptHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "theme": { "type": "string", "minLength": 3 },
    "tone": { "type": "string", "minLength": 3 },
    "visualStyle": { "type": "string", "minLength": 3 },
    "species": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "factions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "cultures": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "techFlavor": { "type": "string", "minLength": 3 },
    "humorLevel": { "enum": ["none", "low", "medium", "medium-high", "high"] },
    "safetyStatus": {
      "type": "object",
      "required": ["status", "safetyRewriteApplied", "blockedPatternIds", "sensitivePatternIds", "deterministicFallbackAllowed"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["safe", "rewritten", "blocked"] },
        "safetyRewriteApplied": { "type": "boolean" },
        "blockedPatternIds": { "type": "array", "items": { "type": "string" } },
        "sensitivePatternIds": { "type": "array", "items": { "type": "string" } },
        "deterministicFallbackAllowed": { "type": "boolean" }
      }
    },
    "keywordHints": { "type": "array", "items": { "type": "string" } },
    "metrics": { "type": "object" }
  }
}

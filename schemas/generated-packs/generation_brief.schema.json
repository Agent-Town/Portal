{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-town-generation-brief-v1",
  "title": "Agent Town Generation Brief",
  "type": "object",
  "required": ["schemaVersion", "theme", "tone", "visualStyle", "speciesOrFactions", "techLevel", "humorLevel", "safetyRewriteApplied"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "agent-town-generation-brief-v1" },
    "theme": { "type": "string", "minLength": 3 },
    "tone": { "type": "string", "minLength": 3 },
    "visualStyle": { "type": "string", "minLength": 3 },
    "speciesOrFactions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "techLevel": { "type": "string", "minLength": 3 },
    "humorLevel": { "enum": ["none", "low", "medium", "medium-high", "high"] },
    "safetyRewriteApplied": { "type": "boolean" }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-town-universe-bible-v1",
  "title": "Agent Town Universe Bible",
  "type": "object",
  "required": ["schemaVersion", "universePackId", "promptHash", "name", "pitch", "playerRole", "cloverRole", "species", "factions", "cultures", "techs", "firstLoop", "text"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "agent-town-universe-bible-v1" },
    "universePackId": { "type": "string", "minLength": 3 },
    "promptHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "name": { "type": "string", "minLength": 3 },
    "pitch": { "type": "string", "minLength": 12 },
    "playerRole": { "type": "string", "minLength": 3 },
    "cloverRole": { "type": "string", "minLength": 3 },
    "species": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "name": { "type": "string", "minLength": 2 },
          "description": { "type": "string", "minLength": 3 }
        }
      }
    },
    "factions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["factionId", "name", "role", "line"],
        "additionalProperties": false,
        "properties": {
          "factionId": { "type": "string", "minLength": 3 },
          "name": { "type": "string", "minLength": 2 },
          "role": { "type": "string", "minLength": 2 },
          "line": { "type": "string", "minLength": 3 }
        }
      }
    },
    "cultures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cultureId", "name", "civicHabit"],
        "additionalProperties": false,
        "properties": {
          "cultureId": { "type": "string", "minLength": 3 },
          "name": { "type": "string", "minLength": 2 },
          "civicHabit": { "type": "string", "minLength": 3 }
        }
      }
    },
    "techs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["techId", "name", "unlockIntent"],
        "additionalProperties": false,
        "properties": {
          "techId": { "type": "string", "minLength": 3 },
          "name": { "type": "string", "minLength": 2 },
          "unlockIntent": { "type": "string", "minLength": 3 }
        }
      }
    },
    "firstLoop": {
      "type": "object",
      "required": ["title", "objective", "successReceipt", "recovery"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "objective": { "type": "string", "minLength": 3 },
        "successReceipt": { "type": "string", "minLength": 3 },
        "recovery": { "type": "string", "minLength": 3 }
      }
    },
    "text": { "type": "object" }
  }
}

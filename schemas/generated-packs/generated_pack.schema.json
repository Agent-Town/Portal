{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-town-generated-pack-v1",
  "title": "Agent Town Generated Pack",
  "type": "object",
  "required": [
    "schemaVersion",
    "packId",
    "ownerAccountId",
    "createdAtMs",
    "generator",
    "prompt",
    "generationBrief",
    "stylePack",
    "universePack",
    "gameplayMapping",
    "techFlavorTree",
    "requesterVoicePack",
    "approvedModifiers",
    "assetManifest",
    "assetPromptPlan",
    "assetScaffold",
    "validationReport"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "agent-town-generated-pack-v1" },
    "packId": { "type": "string", "minLength": 3 },
    "ownerAccountId": { "type": "string", "minLength": 3 },
    "createdAtMs": { "type": "number" },
    "migration": { "type": "object" },
    "remix": { "type": "object" },
    "generator": { "type": "object" },
    "prompt": {
      "type": "object",
      "required": ["hash", "length", "keywordHints"],
      "not": { "anyOf": [{ "required": ["normalizedPrompt"] }, { "required": ["rawPrompt"] }, { "required": ["promptText"] }] }
    },
    "generationBrief": { "type": "object" },
    "stylePack": { "type": "object" },
    "universePack": { "type": "object" },
    "gameplayMapping": { "type": "object" },
    "techFlavorTree": { "type": "object" },
    "requesterVoicePack": { "type": "object" },
    "approvedModifiers": { "type": "object" },
    "assetManifest": { "type": "object" },
    "assetPromptPlan": { "type": "object" },
    "assetScaffold": { "type": "object" },
    "validationReport": { "type": "object" }
  }
}

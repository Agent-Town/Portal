{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-town-asset-prompt-plan-v1",
  "title": "Agent Town Asset Prompt Plan",
  "type": "object",
  "required": ["schemaVersion", "packId", "promptRoot", "assets"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "agent-town-asset-prompt-plan-v1" },
    "packId": { "type": "string", "minLength": 3 },
    "promptRoot": { "type": "string", "minLength": 3 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assetId", "canonicalTarget", "promptFile", "promptHash", "targetSize", "usagePath", "negativePrompt"],
        "additionalProperties": true
      }
    }
  }
}

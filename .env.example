# Copy this file to .env and fill values.

# Privy credentials
# Public value, safe to return to browser.
PRIVY_APP_ID=
# Public value, optional depending on your Privy setup.
PRIVY_CLIENT_ID=
# Private value, server-only. Never sent to browser.
# Required for server polling of sponsored Privy transaction status.
PRIVY_APP_SECRET=

# Optional: additional public config merged into /api/privy/config.
# Must be a JSON object.
# PRIVY_PUBLIC_CONFIG_JSON={"appearance":{"theme":"light"}}

# Optional: load Privy SDK script before creating the wallet bridge.
# PRIVY_SDK_SCRIPT_URL=https://cdn.example.com/privy-sdk.js
# Optional: ESM module URL for Privy JS SDK.
# PRIVY_SDK_MODULE_URL=https://esm.sh/@privy-io/js-sdk-core@0.60.0?bundle
# Optional: login method used by default bridge ("email" or "guest").
# Use "guest" for live Playwright Privy runs that must avoid OTP entry.
# PRIVY_LOGIN_METHOD=guest
# Optional: force start page on/off (defaults to on when PRIVY_APP_ID is set).
# START_PAGE_ENABLED=true
# Optional: allow Privy bridge during NODE_ENV=test (default false).
# ENABLE_PRIVY_IN_TEST=false
# Optional: allow server/index.js to load .env files while NODE_ENV=test.
# The dedicated live Privy Playwright config sets this automatically.
# LOAD_DOTENV_IN_TEST=true

# Optional: comma-separated extra CSP script-src entries.
# CSP_SCRIPT_SRC_EXTRA=https://esm.sh
# Optional: comma-separated extra CSP connect-src entries.
# CSP_CONNECT_SRC_EXTRA=https://example.com,wss://example.com
# Optional: comma-separated extra CSP frame-src entries.
# CSP_FRAME_SRC_EXTRA=https://example.com

# Town Hall ERC-8004 minting (server-side metadata pinning + prepared tx helpers)
# Optional global toggle (default true).
# TOWNHALL_MINT_ENABLED=true

# Pinata JWT used only on the server for IPFS metadata uploads.
# PINATA_JWT=

# EVM (Sepolia) config used by Town Hall mint prepare responses.
# INFURA_ID=
# EVM_ERC8004_CHAIN_ID=11155111
# EVM_ERC8004_NETWORK=sepolia
# EVM_ERC8004_RPC_URL=https://sepolia.infura.io/v3/<INFURA_ID>
# EVM_ERC8004_IDENTITY_REGISTRY=0x8004a818bfb912233c491871b3d84c89a494bd9e

# Solana devnet config used by Town Hall mint prepare responses.
# SOLANA_ERC8004_CLUSTER=devnet
# SOLANA_ERC8004_RPC_URL=https://api.devnet.solana.com
# Optional comma-separated fallback RPC URLs used when prepare calls hit network fetch errors.
# SOLANA_ERC8004_RPC_FALLBACKS=https://api.devnet.solana.com
# Optional: server-side fee payer for Solana sponsorship relay.
# Accepts either a JSON array secret key (`[12,34,...]`) or base58-encoded 64-byte secret key.
# Required if users should mint on Solana without personal SOL.
# SOLANA_ERC8004_FEE_PAYER_SECRET=
# Optional: minimum lamports to keep in the user owner wallet before sponsored register send.
# SOLANA_SPONSOR_OWNER_MIN_LAMPORTS=10000000
# Optional: allow server to transfer lamports from sponsor fee payer to user owner wallet automatically.
# SOLANA_SPONSOR_AUTO_TOPUP=true

# Optional browser module URL overrides for live mint clients.
# SOLANA_WEB3_MODULE_URL=https://esm.sh/@solana/web3.js@1.98.4?bundle
